# A monoenergetic 1 MeV electron beam ionizes carbon at rest: compare the charge state
# distribution to the rate equations, with a macroparticle weight ratio of 4 between
# the electrons and the ions. There are no fields, and the secondary electrons are stored
# in their own species that does not collide, such that the beam energy stays nearly constant.

my_constants.density = 1.e28  # m^-3 (electrons and ions)
my_constants.beam_energy_eV = 1.e6
my_constants.mc2_eV = m_e*clight*clight/q_e

max_step = 300
warpx.const_dt = 1.e-16
warpx.verbose = 0

amr.n_cell = 16
amr.max_grid_size = 8
amr.max_level = 0
geometry.dims = 1
geometry.prob_lo = 0.
geometry.prob_hi = 16.e-9

boundary.field_lo = periodic
boundary.field_hi = periodic
boundary.particle_lo = periodic
boundary.particle_hi = periodic

algo.maxwell_solver = none
algo.particle_shape = 1

particles.species_names = electrons carbon secondaries

electrons.species_type = electron
electrons.injection_style = nuniformpercell
electrons.num_particles_per_cell_each_dim = 250
electrons.profile = constant
electrons.density = density
electrons.momentum_distribution_type = constant
electrons.ux = 0.
electrons.uy = 0.
electrons.uz = sqrt((1. + beam_energy_eV/mc2_eV)^2 - 1.)

carbon.mass = 12.*m_p
carbon.charge = q_e
carbon.injection_style = nuniformpercell
carbon.num_particles_per_cell_each_dim = 1000
carbon.profile = constant
carbon.density = density
carbon.momentum_distribution_type = at_rest
carbon.do_field_ionization = 1
carbon.physical_element = C
carbon.ionization_initial_level = 0
carbon.ionization_product_species = secondaries

secondaries.species_type = electron
secondaries.injection_style = none

collisions.collision_names = ionization
ionization.type = impact_ionization
ionization.species = electrons carbon
ionization.product_species = secondaries

diagnostics.diags_names = diag
diag.intervals = 300
diag.diag_type = Full
diag.fields_to_plot = none
diag.format = openpmd
